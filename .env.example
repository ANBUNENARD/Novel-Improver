# ---------------------------------------------------------------------------
# ProseLens environment variables
#
# Copy to `.env.local` for development. On Vercel, set these in
# Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# ---- Required for model-powered corrections -------------------------------
# Any OpenAI-compatible chat-completions endpoint. Examples:
#   OpenAI      https://api.openai.com/v1
#   xAI         https://api.x.ai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   Ollama      http://localhost:11434/v1
#
# Leave LLM_PROVIDER unset (or set it to `openai`) for every endpoint above.
#
# LLM_API_KEY is optional now. The reader can paste a key into the field at the
# top of the editor, and that key is used for their runs. A key set here takes
# precedence, which is what a hosted deployment wants. Leave it blank locally.
#
# The provider, base url, and timeout are read without a key, so a pasted key
# still reaches the endpoint configured here.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional. Defaults to 60000ms. Long chapters can take a while.
LLM_TIMEOUT_MS=60000

# LLM_MODEL sets the model a pass uses when the reader has not picked one in
# the app. The model row at the top of the editor lists the models this
# provider can serve, cheapest first, each labelled with its real price. Leave
# it blank and the cheapest model runs, which is the one to point a first-time
# reader at. OpenAI bills every model per token and has no ongoing free tier,
# so the picker quotes real prices. The GPT-5 models accept only the default
# temperature; the app knows this and sends none for them.

# ---- Google Gemini -------------------------------------------------------
# Gemini does not speak the OpenAI protocol, so set LLM_PROVIDER=gemini and the
# app calls `generateContent` instead. Get a free key at aistudio.google.com.
# Leave the other three lines alone; these are the defaults for that provider.
# These are the only models in the picker with a genuinely free tier.
#   LLM_PROVIDER=gemini
#   LLM_API_KEY=your-gemini-key
#   LLM_MODEL=gemini-2.5-flash
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# The continuity dictionary is not configured here. It is kept in the reader's
# browser and sent with each request as `storyBible` in the body of
# POST /api/correct. Nothing about it is stored on the server.

# ---- Sentry (scaffolded, off until a DSN is set) -------------------------
# Setting these turns error reporting on. Leave blank to keep it inert.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---- Forms ---------------------------------------------------------------
# /api/submit forwards to the matching webhook per form name.
# Forms: contact | newsletter | waitlist | schedule
WEBHOOK_URL_CONTACT=
WEBHOOK_URL_NEWSLETTER=
WEBHOOK_URL_WAITLIST=
WEBHOOK_URL_SCHEDULE=

# ---- Site ----------------------------------------------------------------
# Used for absolute URLs in metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://proselens.app
