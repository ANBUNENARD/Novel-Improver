    "typecheck": "tsc --noEmit",
    "test:engine": "bun run scripts/test-engine.ts",
    "test:quality": "bun run scripts/test-quality.ts",
    "test:routes": "bun run scripts/verify-routes.ts",
    "test:llm": "bun run scripts/verify-llm-path.ts",
    "test:gemini": "bun run scripts/verify-gemini-path.ts",
    "test:ui": "bun run scripts/verify-ui.ts"
  },
  "dependencies": {
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
