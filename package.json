{
  "name": "proselens",
  "version": "0.1.0",
  "private": true,
  "description": "Paste a machine-translated chapter, get it back as natural English with every change shown beside the original.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
